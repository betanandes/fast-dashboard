# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase
# Painel: https://supabase.com/dashboard → Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Use false enquanto as migrations de TI ainda não tiverem sido aplicadas.
# No modo local o CRUD funciona no navegador sem consultar tabelas inexistentes.
VITE_TI_DATABASE_ENABLED=false

# Cloudflare Turnstile — chave pública do widget.
# A chave secreta deve ser cadastrada somente no Supabase:
# Authentication → Bot and Abuse Protection → CAPTCHA protection.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# SULTS — variáveis exclusivas do servidor (não use prefixo VITE_ no token)
SULTS_API_BASE_URL=https://api.sults.com.br/api/v1
SULTS_TICKET_PATH=/chamado/ticket
SULTS_API_TOKEN=
SULTS_AUTH_HEADER=Authorization
SULTS_AUTH_SCHEME=
SULTS_DEFAULT_USER_ID=
SULTS_TIMEOUT_MS=10000
SULTS_PAGE_LIMIT=100
SULTS_MAX_PAGES=0
# Quantidade máxima de páginas usadas para montar os catálogos do modal.
# 5 equivale a até 500 chamados e evita uma espera longa na primeira abertura.
SULTS_CATALOG_MAX_PAGES=5

# Preset do chamado de lançamento de despesas.
# IDs extraídos da configuração /departamentos/assuntos/1/45.
VITE_SULTS_EXPENSE_DEPARTMENT_ID=1
VITE_SULTS_EXPENSE_SUBJECT_ID=45
SULTS_REQUEST_DELAY_MS=350
SULTS_RETRY_MAX=3
SULTS_RETRY_BASE_MS=1000
TICKET_CACHE_TTL_MS=600000

# Envio de e-mails pelo modal de fornecedores (somente servidor).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fast TI <ti@seudominio.com.br>
